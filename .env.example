# SnapNext AI providers — server-side only. Never expose these keys to the browser.
# Gateway v2 is the production default. Set false only for one-release emergency rollback.
AI_GATEWAY_V2_ENABLED=true

OPENAI_API_KEY=
# Smart (semantic) search. Needs OPENAI_API_KEY; set to false to force it off.
# Without it, search still works on keywords. See docs/SMART_SEARCH.md.
SMART_SEARCH_ENABLED=
# Optional Atlas Vector Search acceleration. Leave empty until the checked-in
# media_embeddings vector index is READY/queryable in Atlas.
SMART_SEARCH_ATLAS_VECTOR_INDEX=
OPENAI_TEXT_ECONOMY_MODEL=gpt-5.6-luna
OPENAI_TEXT_BALANCED_MODEL=gpt-5.6-terra
OPENAI_TEXT_FRONTIER_MODEL=gpt-5.6-sol

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_VISION_MODEL=gemini-3.5-flash
GEMINI_ECONOMY_MODEL=gemini-3.5-flash-lite
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Optional broad fallbacks retained during the controlled migration.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# Router and public URL configuration.
AI_PROVIDER_PRIMARY=openai
AI_PROVIDER_VISION=gemini
AI_PROVIDER_FALLBACK=gemini
AI_DEFAULT_PROVIDER=groq
PUBLIC_APP_URL=https://snapnext.ai
NEXT_PUBLIC_APP_URL=https://snapnext.ai

# Maximum provider-cost reservations. Actual provider-reported cost is settled when available.
AI_TASK_MAX_COST_CAPTION_USD=0.002
AI_TASK_MAX_COST_HASHTAGS_USD=0.001
AI_TASK_MAX_COST_EMOJIS_USD=0.001
AI_TASK_MAX_COST_POSTIDEAS_USD=0.005
AI_TASK_MAX_COST_STORY_USD=0.01
AI_TASK_MAX_COST_MEMORY_STORY_DIRECTOR_USD=0.03
AI_TASK_MAX_COST_CHAT_USD=0.006
AI_TASK_MAX_COST_VISION_USD=0.02
AI_TASK_MAX_COST_IMAGE_CREATE_USD=0.08
AI_TASK_MAX_COST_PHOTO_ENHANCE_USD=0.05
AI_TASK_MAX_COST_PHOTO_RESTORE_USD=0.06
AI_TASK_MAX_COST_AVATAR_MOTION_USD=0.20
AI_TASK_MAX_COST_SHORT_VIDEO_GENERATION_USD=0.50

# Approved visual-generation adapters. Each provider should return outputUrl and, when possible,
# actualCostUsd plus provider/model/usage fields for reconciliation.
IMAGE_GENERATION_PROVIDER_URL=
IMAGE_GENERATION_PROVIDER_KEY=
ENHANCE_PHOTO_PROVIDER_URL=
ENHANCE_PHOTO_PROVIDER_KEY=
AVATAR_MOTION_PROVIDER_URL=
AVATAR_MOTION_PROVIDER_KEY=

# Paid Photo Restoration. Do not sell packs until the provider URL and approved output hosts are configured.
# RESTORATION_OUTPUT_HOSTS is a comma-separated HTTPS hostname allowlist for provider/CDN results.
RESTORATION_OUTPUT_HOSTS=
RESTORATION_CURRENCY=usd
RESTORATION_PACK_SINGLE_PRICE=0.99
RESTORATION_PACK_THREE_PRICE=2.49
RESTORATION_PACK_TEN_PRICE=6.99
RESTORATION_MAX_SOURCE_MB=25
RESTORATION_MAX_OUTPUT_MB=25
RESTORATION_PROVIDER_TIMEOUT_MS=120000
RESTORATION_OUTPUT_TIMEOUT_MS=30000
RESTORATION_RESERVATION_TTL_MINUTES=15
# Used only if Stripe balance-transaction net data is temporarily unavailable.
STRIPE_CARD_PERCENT_FEE=0.029
STRIPE_CARD_FIXED_FEE_CENTS=30

# Extra browser origins allowed to send writes (comma-separated), e.g. a separate
# admin domain. The app's own origin is derived from the request's forwarding
# headers, so do NOT list it here. See docs/ENV_REQUIRED.md.
CORS_ORIGINS=

# Smart Sync secrets and provider credentials — server-side only.
CLOUD_CONNECTOR_SECRET=
CRON_SECRET=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_PHOTOS_CLIENT_ID=
GOOGLE_PHOTOS_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_TENANT_ID=common

# Native app download destinations shown by the web Smart Sync page.
NEXT_PUBLIC_IOS_APP_URL=
NEXT_PUBLIC_ANDROID_APP_URL=

# Universal AI Index — controlled rollout. Keep false until QA and account-data cleanup are verified.
AI_INDEX_ENABLED=false
AI_WORKER_SECRET=
AI_IMAGE_ANALYSIS_MAX_BYTES=26214400
AI_VIDEO_ANALYSIS_MAX_BYTES=15728640